{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BucketShare presets manifest",
  "type": "object",
  "required": [
    "version",
    "schemaVersion",
    "updatedAt",
    "minAppVersion",
    "files"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "schemaVersion": {
      "const": 1
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "minAppVersion": {
      "type": "string",
      "pattern": "^\\d+(\\.\\d+){0,2}$"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256",
          "bytes"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^((catalog|subscriptions|countries)\\.json|tax/[A-Z0-9-]+\\.json)$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          },
          "minAppVersion": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d+){0,2}$"
          }
        }
      }
    }
  }
}
